{
  "name": "async-react-modal",
  "version": "0.1.0",
  "description": "Type-safe promise-based modals for React",
  "author": "Jan Schaible",
  "keywords": [
    "react",
    "modal",
    "async",
    "promise",
    "dialog"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janschaible/async-react-modal.git"
  },
  "homepage": "https://github.com/janschaible/async-react-modal#readme",
  "bugs": {
    "url": "https://github.com/janschaible/async-react-modal/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:example": "npm run build && npm run build:example:app",
    "build:example:app": "vite build example --outDir dist",
    "example": "npm run build && vite example --port 4173",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
